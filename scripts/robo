#!/usr/bin/env bash
# RoboticelaOS pipeline launcher (Git Bash / MSYS2 / WSL).
#
#   ./scripts/robo check
#   ./scripts/robo build-all
#   ./scripts/robo test-all
#   ./scripts/robo validate-deployment
#   ./scripts/robo run-qemu
#
# The pipeline itself is PowerShell, which is what this project's toolchain is
# driven from. This launcher only locates it and forwards, preserving the exit
# code so CI sees real failures.

set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ps1="$here/pipeline/robo.ps1"

if [ ! -f "$ps1" ]; then
  echo "robo: pipeline entry point not found: $ps1" >&2
  exit 2
fi

# Windows PowerShell cannot read MSYS-style paths, so convert when possible.
if command -v cygpath >/dev/null 2>&1; then
  ps1="$(cygpath -w "$ps1")"
fi

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File "$ps1" "$@"
elif command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ps1" "$@"
elif command -v powershell >/dev/null 2>&1; then
  exec powershell -NoProfile -ExecutionPolicy Bypass -File "$ps1" "$@"
fi

echo "robo: PowerShell not found." >&2
echo "      RoboticelaOS builds on a Windows host with PowerShell 5.1+ or PowerShell 7+." >&2
exit 2
